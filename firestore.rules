rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /app_state/{stateId} {
      allow read, write: if isValidId(stateId);
    }

    match /app_data/{docId} {
      allow read, write: if isValidId(docId);
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /site_settings/{settingsId} {
      allow read, write: if isValidId(settingsId);
    }
  }
}
